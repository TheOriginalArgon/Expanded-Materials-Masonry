            <li>EM_VFEFactory_DigForSiltstoneChunk</li>
            <li>EM_VFEFactory_DigForSchistChunk</li>
            <li>EM_VFEFactory_DigForShaleChunk</li>
            <li>EM_VFEFactory_DigForBasaltChunk</li>
        </value>
