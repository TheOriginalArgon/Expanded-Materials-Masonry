            <li MayRequire="Argon.ExpandedMaterials.Metals">EM_VFEFactory_SmeltSiliconFromSand</li>
            <li>EM_VFEFactory_MakeConcreteMix</li>
            <li>EM_VFEFactory_MakeAdobeBricks</li>
            <li>EM_VFEFactory_MakeClayBricks</li>
        </value>
