    <Operation Class="PatchOperationInsert">
        <xpath>/Defs/ThingDef [defName="VFEFactory_AutomatedMasonrySaw"]/comps/li [@Class="PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes/li[text()="VFEFactory_MakeStoneBlocks"]</xpath>
